---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:"Yu Mincho",YuMincho,Georgia,serif;color:#171717;background:#f7f5ef}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(1040px,calc(100% - 50px));margin:auto}header{padding:28px 0;display:flex;justify-content:space-between;align-items:baseline}.brand{font-size:1.3rem;font-weight:700;text-decoration:none;letter-spacing:.04em}nav{display:flex;gap:22px;font:.7rem Arial,sans-serif;letter-spacing:.05em}nav a{text-decoration:none}.company{padding:15vh 0 12vh}.company h1{font-size:clamp(4rem,11vw,9rem);font-weight:400;line-height:.9;letter-spacing:-.055em;margin:0 0 42px}.company p{font-size:1.08rem;line-height:1.9;max-width:580px;margin-left:auto}.rule{border-top:1px solid #222}.section{display:grid;grid-template-columns:190px 1fr;padding:34px 0 64px;border-bottom:1px solid #bdb9ae}.section h2{font: .7rem Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;margin:5px 0}.items{display:grid;gap:0}.item{display:flex;justify-content:space-between;gap:30px;padding:0 0 24px;margin-bottom:24px;border-bottom:1px solid #d2cec4}.item:last-child{border-bottom:0;margin-bottom:0}.item strong{font-size:1.6rem;font-weight:400}.item span{font:.72rem Arial,sans-serif;color:#777;white-space:nowrap}.plain{font-size:1.1rem;line-height:1.9;max-width:600px;margin:0}.contact-line{font-size:clamp(1.8rem,4vw,3.5rem);line-height:1.2;margin:0}footer{padding:24px 0 42px;font:.68rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 30px)}header{padding:22px 0}.brand{font-size:1.15rem}.company{padding:11vh 0 9vh}.company h1{font-size:4.1rem;margin-bottom:34px}.company p{margin-left:0}.section{grid-template-columns:1fr;gap:28px;padding:28px 0 48px}.item strong{font-size:1.4rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>WORKS</a><a href={base+'/about/'}>COMPANY</a><a href={base+'/contact/'}>CONTACT</a></nav></header><main><slot/></main><footer>SOWSEI INC. / KANAGAWA, JAPAN</footer></body></html>