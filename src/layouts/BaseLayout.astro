---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#191919;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(980px,calc(100% - 44px));margin:auto}header{height:64px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #c9c5bb}.brand{font-size:1rem;font-weight:700;text-decoration:none}nav{display:flex;gap:18px;font:.65rem Arial,sans-serif}nav a{text-decoration:none}.intro{padding:24px 0 18px}.intro p{font-size:.88rem;line-height:1.65;margin:0;max-width:560px}.feature{display:grid;grid-template-columns:1.15fr .85fr;border:1px solid #bdb8ad;margin:0 0 16px;background:#f2efe6}.mock{min-height:190px;padding:18px;display:flex;align-items:center;justify-content:center;background:#e8e4da}.phone{width:112px;height:168px;border:1px solid #777;border-radius:14px;background:#fff;padding:11px;box-shadow:0 7px 20px #00000012}.phone i{display:block;height:7px;width:38px;background:#ddd;border-radius:8px;margin:0 auto 17px}.swatches{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.swatches b{height:30px;border-radius:4px;background:#dedbd2}.swatches b:nth-child(2){background:#b7b4aa}.swatches b:nth-child(3){background:#f1eee6}.feature-copy{padding:22px;display:flex;flex-direction:column;justify-content:center}.kind{font:.61rem Arial,sans-serif;color:#777}.feature h1{font-size:1.18rem;font-weight:400;margin:8px 0}.feature p{font-size:.77rem;line-height:1.55;color:#555;margin:0 0 12px}.text-link{font:.66rem Arial,sans-serif;text-underline-offset:3px}.process{border-top:1px solid #222;border-bottom:1px solid #222;padding:16px 0}.process-head{display:flex;justify-content:space-between;gap:20px;margin-bottom:13px}.process-head strong{font-size:.9rem;font-weight:400}.process-head span{font:.61rem Arial,sans-serif;color:#777}.steps{display:grid;grid-template-columns:repeat(5,1fr)}.step{border-left:1px solid #c9c5bb;padding:7px 11px}.step:first-child{border-left:0;padding-left:0}.step b{display:block;font:.58rem Arial,sans-serif;color:#888;margin-bottom:4px}.step span{font-size:.72rem}.company-strip{display:grid;grid-template-columns:1fr auto;gap:20px;padding:16px 0 20px;align-items:end}.company-strip p{font-size:.76rem;line-height:1.6;margin:0;max-width:560px}.secondary{display:flex;gap:18px;font-size:.7rem}.secondary a{text-underline-offset:3px}footer{border-top:1px solid #222;padding:14px 0 20px;font:.62rem Arial,sans-serif;color:#555}.page-head{padding:24px 0 18px;border-bottom:1px solid #222}.page-head>span,.detail h2{font:.61rem Arial,sans-serif;color:#777;font-weight:400}.page-head h1{font-size:1.12rem;font-weight:400;margin:7px 0}.page-head p,.detail p{font-size:.79rem;line-height:1.6;max-width:600px;margin:0}.page-list{border-bottom:1px solid #222}.page-row{display:grid;grid-template-columns:82px 1fr auto;gap:16px;padding:14px 0;border-bottom:1px solid #c9c5bb;text-decoration:none}.page-row:last-child{border:0}.page-row>span,.page-row b{font:.6rem Arial,sans-serif;color:#777;font-weight:400}.page-row strong{font-size:.96rem;font-weight:400}.page-row p{font-size:.72rem;line-height:1.5;color:#555;margin:4px 0 0}.detail{padding:18px 0;border-bottom:1px solid #c9c5bb}.detail h2{margin:0 0 7px}.detail h2:not(:first-child){margin-top:18px}.process-card{margin:16px 0 0;border:1px solid #c9c5bb;padding:14px}.process-card .steps{margin-top:8px}
@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:54px}.brand{font-size:.92rem}nav{gap:13px;font-size:.59rem}.intro{padding:16px 0 13px}.intro p{font-size:.77rem;max-width:310px}.feature{grid-template-columns:42% 58%;margin-bottom:13px}.mock{min-height:160px;padding:10px}.phone{width:78px;height:124px;border-radius:10px;padding:8px}.phone i{height:5px;width:27px;margin-bottom:12px}.swatches{gap:4px}.swatches b{height:22px}.feature-copy{padding:14px 12px}.feature h1{font-size:.95rem;margin:5px 0}.feature p{font-size:.68rem;line-height:1.48;margin-bottom:8px}.process{padding:13px 0}.process-head{margin-bottom:10px}.process-head strong{font-size:.82rem}.steps{grid-template-columns:repeat(5,1fr)}.step{padding:5px 6px}.step b{font-size:.5rem}.step span{font-size:.61rem}.company-strip{grid-template-columns:1fr;padding:13px 0 17px;gap:10px}.company-strip p{font-size:.72rem}.page-head{padding:17px 0 14px}.page-head h1{font-size:.98rem}.page-head p,.detail p{font-size:.74rem}.page-row{grid-template-columns:54px 1fr auto;gap:9px;padding:12px 0}.page-row strong{font-size:.88rem}.page-row p{font-size:.66rem}.detail{padding:15px 0}.process-card{padding:10px;margin-top:12px}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Products</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>