---
const { title = 'SOWSEI', description = 'Sowsei Inc.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['Work', '/products/'],
  ['About', '/about/'],
  ['Contact', '/contact/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root { font-family: Arial, "Helvetica Neue", sans-serif; color:#0d0d0d; background:#f6f5f1; font-synthesis:none; }
    * { box-sizing:border-box; }
    body { margin:0; background:#f6f5f1; line-height:1.5; }
    a { color:inherit; text-decoration:none; }
    header, main { width:min(1440px, calc(100% - 64px)); margin-inline:auto; }
    header { height:78px; display:flex; align-items:center; justify-content:flex-end; border-bottom:1px solid #111; }
    .brand { display:none; }
    nav { display:flex; gap:30px; font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; }
    nav a { padding:8px 0; }
    nav a[aria-current="page"] { border-bottom:1px solid; }
    main { min-height:calc(100vh - 78px); }
    .hero { min-height:calc(100vh - 78px); display:flex; flex-direction:column; justify-content:space-between; padding:7vh 0 5vh; }
    .wordmark { font-size:clamp(5rem, 18.2vw, 17rem); font-weight:700; line-height:.78; letter-spacing:-.085em; margin:0 0 0 -.055em; white-space:nowrap; }
    .hero-meta { display:flex; align-items:flex-end; justify-content:space-between; gap:40px; border-top:1px solid #111; padding-top:18px; font-size:.76rem; text-transform:uppercase; letter-spacing:.08em; }
    .hero-meta p { margin:0; }
    .hero-meta .jp { font-family:"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif; text-transform:none; letter-spacing:.12em; }
    .grid { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid #111; margin:0 0 12vh; }
    .entry { min-height:250px; padding:24px 24px 24px 0; border-bottom:1px solid #111; display:flex; flex-direction:column; }
    .entry + .entry { border-left:1px solid #111; padding-left:24px; }
    h1 { font-size:clamp(3.8rem,10vw,8rem); line-height:.9; letter-spacing:-.065em; margin:0 0 48px; }
    h2 { font-size:clamp(1.8rem,3.2vw,3rem); line-height:1; letter-spacing:-.045em; margin:0; }
    p { max-width:660px; }
    .entry p { margin-top:auto; margin-bottom:0; font-size:.88rem; }
    .page { padding:12vh 0 16vh; max-width:960px; }
    .note { margin-top:56px; padding-top:20px; border-top:1px solid #111; font-size:.82rem; }
    footer { background:#0d0d0d; color:#f6f5f1; padding:28px max(32px, calc((100vw - 1440px)/2)); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em; }
    @media (max-width:700px) {
      header, main { width:calc(100% - 32px); }
      header { height:66px; }
      nav { gap:18px; font-size:.66rem; }
      .hero { min-height:calc(100svh - 66px); padding:5vh 0 24px; }
      .wordmark { font-size:clamp(4.25rem, 22.5vw, 7.2rem); letter-spacing:-.09em; white-space:normal; }
      .hero-meta { align-items:flex-start; flex-direction:column; gap:7px; font-size:.65rem; }
      .grid { grid-template-columns:1fr; margin-bottom:9vh; }
      .entry,.entry + .entry { min-height:155px; padding:22px 0; border-left:0; }
      .page { padding:9vh 0 12vh; }
      footer { padding-left:16px; padding-right:16px; }
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">SOWSEI</a>
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer>© Sowsei Inc.</footer>
</body>
</html>