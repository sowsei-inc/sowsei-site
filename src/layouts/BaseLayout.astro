---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#191919;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(980px,calc(100% - 44px));margin:auto}header{height:68px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #c9c5bb}.brand{font-size:1.04rem;font-weight:700;text-decoration:none}nav{display:flex;gap:18px;font:.66rem Arial,sans-serif}nav a{text-decoration:none}.lead{padding:34px 0 26px;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:end}.lead h1{font-size:1.5rem;font-weight:400;line-height:1.45;margin:0}.lead p{font-size:.9rem;line-height:1.7;margin:0}.works{border-top:1px solid #222}.work{display:grid;grid-template-columns:92px 1fr auto;gap:18px;padding:17px 0;border-bottom:1px solid #c9c5bb;align-items:baseline}.work .state,.work small{font:.65rem Arial,sans-serif;color:#777}.work strong{font-size:1.14rem;font-weight:400}.bottom{padding:25px 0 31px;font-size:.86rem;line-height:1.65;max-width:600px}footer{border-top:1px solid #222;padding:16px 0 22px;font:.64rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:56px}.brand{font-size:.98rem}nav{gap:14px;font-size:.62rem}.lead{padding:22px 0 18px;grid-template-columns:1fr;gap:9px}.lead h1{font-size:1.12rem;line-height:1.5}.lead p{font-size:.82rem;line-height:1.65}.work{grid-template-columns:64px 1fr;padding:13px 0;gap:12px}.work strong{font-size:1rem}.work small{grid-column:2}.bottom{padding:20px 0 25px;font-size:.8rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>