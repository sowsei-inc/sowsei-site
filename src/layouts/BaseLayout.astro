---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#191919;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(980px,calc(100% - 44px));margin:auto}header{height:64px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #c9c5bb}.brand{font-size:1rem;font-weight:700;text-decoration:none}nav{display:flex;gap:18px;font:.65rem Arial,sans-serif}nav a{text-decoration:none}.intro{padding:26px 0 20px;border-bottom:1px solid #222}.intro p{font-size:.9rem;line-height:1.7;margin:0;max-width:560px}.destinations{border-bottom:1px solid #222}.destination{display:grid;grid-template-columns:150px 1fr auto;gap:24px;padding:20px 0;border-bottom:1px solid #c9c5bb;text-decoration:none;align-items:start}.destination:last-child{border-bottom:0}.kind{font:.63rem Arial,sans-serif;color:#777;padding-top:4px}.destination h2{font-size:1.08rem;font-weight:400;margin:0 0 5px}.destination p{font-size:.78rem;line-height:1.55;margin:0;color:#555}.go{font:.64rem Arial,sans-serif;white-space:nowrap;padding-top:4px}.secondary{display:flex;gap:22px;padding:18px 0 24px;font-size:.76rem}.secondary a{text-underline-offset:3px}footer{border-top:1px solid #222;padding:14px 0 20px;font:.62rem Arial,sans-serif;color:#555}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:54px}.brand{font-size:.92rem}nav{gap:13px;font-size:.59rem}.intro{padding:18px 0 15px}.intro p{font-size:.78rem;line-height:1.65;max-width:310px}.destination{grid-template-columns:58px 1fr;gap:10px;padding:13px 0}.kind{font-size:.57rem;padding-top:3px}.destination h2{font-size:.92rem;margin-bottom:4px}.destination p{font-size:.7rem;line-height:1.5}.go{display:none}.secondary{gap:18px;padding:15px 0 19px;font-size:.7rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Products</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>