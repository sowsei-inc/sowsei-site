---
const { title = 'Sowsei Inc.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#20201e;background:#faf8f2}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(900px,calc(100% - 46px));margin:auto}header{padding:28px 0;display:flex;justify-content:space-between;align-items:center}.brand{font-size:1.25rem;font-weight:700;text-decoration:none}nav{display:flex;gap:20px;font:.7rem Arial,sans-serif}nav a{text-decoration:none}.opening{padding:10vh 0 9vh;border-bottom:1px solid #aaa69c}.opening h1{font-size:clamp(2.5rem,6vw,5rem);font-weight:400;line-height:1.06;letter-spacing:-.035em;margin:0 0 30px;max-width:780px}.opening p{font-size:1.05rem;line-height:1.85;max-width:590px}.journal-head{display:flex;justify-content:space-between;padding:24px 0 14px;font:.68rem Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}.entry{display:grid;grid-template-columns:110px 1fr;gap:26px;padding:34px 0;border-top:1px solid #cbc7bd}.entry time{font:.7rem Arial,sans-serif;color:#777}.entry h2{font-size:1.7rem;font-weight:400;margin:0 0 10px}.entry p{margin:0;line-height:1.75;color:#4c4b47}.entry .kind{display:block;margin-top:15px;font:.66rem Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#777}.closing{padding:9vh 0 12vh;border-top:1px solid #aaa69c;margin-top:22px}.closing p{max-width:560px;font-size:1.15rem;line-height:1.85;margin:0}footer{border-top:1px solid #aaa69c;padding:22px 0 38px;font:.68rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 30px)}header{padding:22px 0}.opening{padding:9vh 0 7vh}.opening h1{font-size:2.9rem}.entry{grid-template-columns:1fr;gap:10px;padding:28px 0}.journal-head{padding-top:20px}}
</style></head><body><header><a class="brand" href={base+'/'}>Sowsei Inc.</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>株式会社創正 — Kanagawa, Japan</footer></body></html>