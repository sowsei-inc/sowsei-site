---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:"Yu Mincho",YuMincho,Georgia,serif;color:#1d1d1b;background:#fff}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(960px,calc(100% - 48px));margin:auto}header{height:62px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:1rem;font-weight:700;text-decoration:none}nav{display:flex;gap:19px;font:.67rem Arial,sans-serif}nav a{text-decoration:none}.notice{font: .65rem Arial,sans-serif;border-top:1px solid #222;border-bottom:1px solid #222;padding:9px 0;display:flex;justify-content:space-between}.intro{display:grid;grid-template-columns:180px 1fr;padding:34px 0 28px}.intro h1{font-size:.68rem;font-weight:400;margin:3px 0;color:#777}.intro p{font-size:1.03rem;line-height:1.75;max-width:570px;margin:0}.list{border-top:1px solid #bbb}.row{display:grid;grid-template-columns:110px 1fr 100px;gap:18px;padding:14px 0;border-bottom:1px solid #bbb;align-items:baseline}.row span{font:.64rem Arial,sans-serif;color:#777}.row strong{font-size:1rem;font-weight:400}.company{display:grid;grid-template-columns:180px 1fr;padding:28px 0}.company h2{font:.67rem Arial,sans-serif;font-weight:400;margin:2px 0;color:#777}.company dl{display:grid;grid-template-columns:100px 1fr;gap:8px 16px;margin:0;font-size:.78rem;line-height:1.6}.company dt{color:#777}.company dd{margin:0}footer{border-top:1px solid #222;padding:15px 0 22px;font:.62rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:54px}.brand{font-size:.93rem}nav{gap:13px;font-size:.6rem}.notice{font-size:.59rem;padding:7px 0}.intro{grid-template-columns:1fr;gap:8px;padding:22px 0 19px}.intro p{font-size:.88rem;line-height:1.7}.row{grid-template-columns:66px 1fr auto;gap:10px;padding:11px 0}.row strong{font-size:.9rem}.row span{font-size:.59rem}.company{grid-template-columns:1fr;gap:10px;padding:21px 0}.company dl{grid-template-columns:80px 1fr;font-size:.72rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>制作物</a><a href={base+'/about/'}>会社概要</a><a href={base+'/contact/'}>お問い合わせ</a></nav></header><main><slot/></main><footer>© Sowsei Inc.</footer></body></html>