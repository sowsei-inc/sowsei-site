---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;color:#171717;background:#f5f4ef}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(1040px,calc(100% - 48px));margin:auto}header{height:64px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:.98rem;font-weight:600;text-decoration:none}nav{display:flex;gap:20px;font-size:.68rem}nav a{text-decoration:none}.visual{display:grid;grid-template-columns:1.35fr .65fr;min-height:300px;border-top:1px solid #aaa;border-bottom:1px solid #aaa}.visual-main{padding:30px 28px 28px 0;display:flex;flex-direction:column;justify-content:space-between}.visual-main .label{font-size:.68rem;color:#777}.visual-main h1{font-size:1.42rem;line-height:1.45;font-weight:500;margin:0;max-width:390px}.visual-side{border-left:1px solid #aaa;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;background:#e8e5dc}.visual-side strong{font-size:1rem;font-weight:500}.visual-side p{font-size:.78rem;line-height:1.6;margin:7px 0 0;color:#555}.strip{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #aaa}.strip a{padding:16px 18px;border-right:1px solid #aaa;text-decoration:none}.strip a:last-child{border:0}.strip span{display:block;font-size:.62rem;color:#777;margin-bottom:5px}.strip strong{font-size:.9rem;font-weight:500}.about{display:grid;grid-template-columns:150px 1fr;padding:26px 0 30px}.about h2{font-size:.66rem;font-weight:400;margin:2px 0;color:#777}.about p{font-size:.86rem;line-height:1.7;max-width:560px;margin:0}footer{border-top:1px solid #aaa;padding:16px 0 22px;font-size:.62rem;color:#666}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:56px}.brand{font-size:.92rem}nav{gap:13px;font-size:.61rem}.visual{grid-template-columns:1fr;min-height:0}.visual-main{height:210px;padding:18px 0}.visual-main h1{font-size:1.08rem;max-width:290px}.visual-side{border-left:0;border-top:1px solid #aaa;padding:15px 14px;min-height:92px}.visual-side strong{font-size:.9rem}.visual-side p{font-size:.72rem}.strip{grid-template-columns:1fr}.strip a{padding:12px 0;border-right:0;border-bottom:1px solid #aaa}.strip a:last-child{border-bottom:0}.about{grid-template-columns:1fr;gap:8px;padding:20px 0 24px}.about p{font-size:.79rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>制作物</a><a href={base+'/about/'}>会社</a><a href={base+'/contact/'}>連絡</a></nav></header><main><slot/></main><footer>株式会社創正　神奈川県</footer></body></html>