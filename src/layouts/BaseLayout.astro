---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#191919;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(980px,calc(100% - 44px));margin:auto}header{height:72px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #c9c5bb}.brand{font-size:1.1rem;font-weight:700;text-decoration:none}nav{display:flex;gap:20px;font:.68rem Arial,sans-serif}nav a{text-decoration:none}.lead{padding:44px 0 34px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end}.lead h1{font-size:1.7rem;font-weight:400;line-height:1.45;margin:0}.lead p{font-size:.96rem;line-height:1.75;margin:0}.works{border-top:1px solid #222}.work{display:grid;grid-template-columns:100px 1fr auto;gap:20px;padding:20px 0;border-bottom:1px solid #c9c5bb;align-items:baseline}.work .state,.work small{font:.68rem Arial,sans-serif;color:#777}.work strong{font-size:1.25rem;font-weight:400}.bottom{padding:32px 0 42px;font-size:.92rem;line-height:1.7;max-width:600px}footer{border-top:1px solid #222;padding:18px 0 26px;font:.66rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:60px}.lead{padding:28px 0 24px;grid-template-columns:1fr;gap:12px}.lead h1{font-size:1.35rem}.work{grid-template-columns:72px 1fr;padding:16px 0}.work small{grid-column:2}.bottom{padding:26px 0 32px}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>