---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:"Yu Mincho",YuMincho,Georgia,serif;color:#171717;background:#f7f5ef}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(1040px,calc(100% - 46px));margin:auto}header{height:70px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #bdb9ae}.brand{font-size:1.12rem;font-weight:700;text-decoration:none;letter-spacing:.03em}nav{display:flex;gap:20px;font:.68rem Arial,sans-serif}nav a{text-decoration:none}.first{min-height:280px;display:flex;flex-direction:column;justify-content:center;padding:28px 0}.first h1{font-size:1.65rem;font-weight:400;line-height:1.5;margin:0 0 16px}.first p{font-size:.95rem;line-height:1.8;max-width:570px;margin:0}.section{display:grid;grid-template-columns:150px 1fr;padding:22px 0;border-top:1px solid #bdb9ae}.section h2{font:.68rem Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;margin:4px 0}.items{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.item strong{display:block;font-size:1.15rem;font-weight:400;margin-bottom:5px}.item span{font:.68rem Arial,sans-serif;color:#777}.plain{font-size:.95rem;line-height:1.75;max-width:600px;margin:0}footer{margin-top:28px;border-top:1px solid #222;padding:18px 0 26px;font:.66rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:60px}.first{min-height:210px;padding:22px 0}.first h1{font-size:1.35rem}.section{grid-template-columns:1fr;gap:14px;padding:18px 0}.items{grid-template-columns:1fr;gap:14px}.item{display:flex;justify-content:space-between;align-items:baseline}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. / Kanagawa, Japan</footer></body></html>