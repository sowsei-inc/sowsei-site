---
const { title = 'SOWSEI' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Arial,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;color:#171717;background:#f1efe8}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}header,main{width:min(1180px,calc(100% - 40px));margin:auto}header{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #aaa59a}.brand{font-weight:700;letter-spacing:.04em}nav{display:flex;gap:22px;font-size:.78rem}.hero{padding:13vh 0 9vh;border-bottom:1px solid #aaa59a}.kicker{font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;margin-bottom:22px}.hero h1{font-size:clamp(2.8rem,7vw,6.2rem);line-height:.98;letter-spacing:-.055em;margin:0;max-width:950px}.hero p{font-size:1rem;max-width:560px;margin:32px 0 0}.work{padding:34px 0 12vh}.work-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:34px}.work h2{font-size:1rem;margin:0}.status{font-size:.72rem}.shelf{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.item{min-height:270px;background:#ddd9cf;padding:22px;display:flex;flex-direction:column;justify-content:space-between}.item small{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}.item strong{font-size:1.5rem}.item.empty{background:transparent;border:1px dashed #aaa59a;color:#6b685f}footer{border-top:1px solid #aaa59a;padding:24px max(20px,calc((100vw - 1180px)/2));font-size:.7rem}@media(max-width:700px){header,main{width:calc(100% - 28px)}header{height:62px}nav{gap:14px}.hero{padding:11vh 0 7vh}.hero h1{font-size:3.35rem}.shelf{grid-template-columns:1fr}.item{min-height:190px}}
</style></head><body><header><a class="brand" href={base+'/'}>SOWSEI</a><nav><a href={base+'/products/'}>WORK</a><a href={base+'/about/'}>ABOUT</a><a href={base+'/contact/'}>CONTACT</a></nav></header><main><slot/></main><footer>株式会社創正 · Kanagawa, Japan</footer></body></html>