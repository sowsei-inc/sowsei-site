---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#20201e;background:#faf8f2}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(900px,calc(100% - 44px));margin:auto}header{height:70px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:1.08rem;font-weight:700;text-decoration:none}nav{display:flex;gap:19px;font:.68rem Arial,sans-serif}nav a{text-decoration:none}.now{border-top:1px solid #aaa69c;border-bottom:1px solid #aaa69c;padding:22px 0}.now-head{display:flex;justify-content:space-between;font:.65rem Arial,sans-serif;color:#777;margin-bottom:18px}.now-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.now-item{border-right:1px solid #cbc7bd;padding-right:18px}.now-item:last-child{border:0}.now-item h1,.now-item h2{font-size:1.2rem;font-weight:400;margin:0 0 8px}.now-item p{font-size:.86rem;line-height:1.6;margin:0;color:#555}.intro{padding:32px 0 28px}.intro p{font-size:1rem;line-height:1.8;max-width:610px;margin:0}.entries{border-top:1px solid #cbc7bd}.entry{display:grid;grid-template-columns:95px 1fr;gap:20px;padding:18px 0;border-bottom:1px solid #cbc7bd}.entry time{font:.67rem Arial,sans-serif;color:#777}.entry strong{font-size:1.05rem;font-weight:400}.entry p{font-size:.86rem;line-height:1.6;margin:5px 0 0;color:#555}footer{margin-top:34px;border-top:1px solid #aaa69c;padding:18px 0 26px;font:.66rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:60px}.now{padding:18px 0}.now-grid{grid-template-columns:1fr;gap:0}.now-item{border-right:0;border-bottom:1px solid #d1cdc3;padding:13px 0}.now-item:last-child{border-bottom:0}.intro{padding:24px 0 22px}.entry{grid-template-columns:76px 1fr;padding:15px 0}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>