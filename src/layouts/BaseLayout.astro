---
const { title = 'Sowsei Inc.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#171717;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main{width:min(920px,calc(100% - 44px));margin:auto}header{padding:30px 0;display:flex;justify-content:space-between;align-items:baseline}.brand{font-size:1.25rem;font-weight:700;text-decoration:none}nav{display:flex;gap:20px;font-family:Arial,sans-serif;font-size:.72rem}nav a{text-decoration:none}.intro{padding:14vh 0 11vh}.intro .date{font-family:Arial,sans-serif;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.intro h1{font-size:clamp(2.7rem,6.5vw,5.5rem);font-weight:400;line-height:1.04;letter-spacing:-.04em;margin:24px 0 30px;max-width:820px}.intro p{font-size:1.08rem;line-height:1.8;max-width:620px}.index{border-top:1px solid #222}.row{display:grid;grid-template-columns:90px 1fr auto;gap:20px;padding:24px 0;border-bottom:1px solid #bbb7ad;align-items:baseline}.row span{font-family:Arial,sans-serif;font-size:.7rem;text-transform:uppercase}.row strong{font-size:1.45rem;font-weight:400}.row em{font-size:.85rem;color:#777;font-style:normal}.note{padding:70px 0 12vh;max-width:600px;line-height:1.8}footer{width:min(920px,calc(100% - 44px));margin:auto;border-top:1px solid #222;padding:24px 0 40px;font-family:Arial,sans-serif;font-size:.68rem}@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{padding:22px 0}.intro{padding:10vh 0 8vh}.intro h1{font-size:3rem}.row{grid-template-columns:52px 1fr}.row em{grid-column:2}}
</style></head><body><header><a class="brand" href={base+'/'}>Sowsei Inc.</a><nav><a href={base+'/products/'}>Index</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>株式会社創正 — Kanagawa, Japan</footer></body></html>