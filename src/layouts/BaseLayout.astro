---
const { title = '株式会社創正', description = '株式会社創正の公式サイト' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['Products', '/products/'],
  ['Sousei-line', '/sousei-line/'],
  ['About', '/about/'],
  ['Contact', '/contact/'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root {
      font-family: "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", Arial, sans-serif;
      color:#171717;
      background:#f3f1ec;
      font-synthesis:none;
    }
    * { box-sizing:border-box; }
    html { background:#171717; }
    body { margin:0; line-height:1.72; background:#f3f1ec; }
    a { color:inherit; text-decoration:none; }
    header, main, footer { width:min(1180px, calc(100% - 56px)); margin-inline:auto; }
    header {
      min-height:92px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:32px;
      border-bottom:1px solid #b9b6ae;
    }
    .brand {
      font-size:.92rem;
      font-weight:700;
      letter-spacing:.16em;
      white-space:nowrap;
    }
    nav { display:flex; gap:30px; font-size:.76rem; letter-spacing:.08em; }
    nav a { padding:8px 0; color:#4e4c47; }
    nav a:hover, nav a[aria-current="page"] { color:#111; }
    nav a[aria-current="page"] { border-bottom:1px solid #111; }
    main { min-height:72vh; }
    .hero {
      min-height:68vh;
      padding:12vh 0 9vh;
      display:flex;
      flex-direction:column;
      justify-content:center;
      max-width:1000px;
    }
    .eyebrow {
      font-size:.68rem;
      font-weight:700;
      letter-spacing:.24em;
      text-transform:uppercase;
      color:#77736b;
      margin-bottom:26px;
    }
    h1 {
      font-size:clamp(3.2rem, 8.8vw, 7.4rem);
      font-weight:500;
      line-height:.93;
      letter-spacing:-.065em;
      margin:0 0 42px;
    }
    h2 {
      font-size:clamp(1.7rem, 3.2vw, 2.7rem);
      font-weight:500;
      line-height:1.12;
      letter-spacing:-.035em;
      margin:0 0 18px;
    }
    p { max-width:680px; margin-top:0; }
    .lead {
      font-size:clamp(1rem, 1.8vw, 1.2rem);
      color:#494741;
      margin:0;
      max-width:560px;
    }
    .grid {
      display:grid;
      grid-template-columns:repeat(2,1fr);
      border-top:1px solid #8e8a81;
      margin-bottom:13vh;
    }
    .entry {
      min-height:230px;
      padding:38px 0 34px;
      border-bottom:1px solid #8e8a81;
      display:flex;
      flex-direction:column;
      transition:padding .18s ease;
    }
    .entry:nth-child(odd) { padding-right:44px; }
    .entry:nth-child(even) { padding-left:44px; border-left:1px solid #8e8a81; }
    .entry p { color:#55524c; }
    .entry span {
      display:block;
      color:#77736b;
      font-size:.72rem;
      letter-spacing:.08em;
      margin-top:auto;
    }
    @media (hover:hover) {
      .entry:hover { padding-top:32px; }
    }
    .page { padding:11vh 0 15vh; max-width:900px; }
    .page h1 { font-size:clamp(3rem,7vw,6.2rem); }
    .note {
      margin-top:56px;
      padding-top:24px;
      border-top:1px solid #b9b6ae;
      color:#6c6962;
      font-size:.86rem;
    }
    footer {
      width:100%;
      background:#171717;
      color:#d7d3ca;
      padding:30px max(28px, calc((100vw - 1180px)/2)) 44px;
      font-size:.72rem;
      letter-spacing:.08em;
    }
    @media (max-width:700px) {
      header, main { width:calc(100% - 36px); }
      header {
        min-height:76px;
        align-items:flex-start;
        padding:19px 0 15px;
        flex-direction:column;
        gap:13px;
      }
      .brand { font-size:.82rem; }
      nav {
        width:100%;
        overflow-x:auto;
        gap:20px;
        padding-bottom:2px;
        font-size:.69rem;
      }
      .hero {
        min-height:61vh;
        padding:9vh 0 8vh;
      }
      .eyebrow { margin-bottom:22px; }
      h1 {
        font-size:clamp(3.35rem, 17vw, 5.5rem);
        margin-bottom:32px;
      }
      .grid { grid-template-columns:1fr; margin-bottom:10vh; }
      .entry,.entry:nth-child(odd),.entry:nth-child(even) {
        min-height:190px;
        padding:30px 0 26px;
        border-left:0;
      }
      .page { padding:9vh 0 12vh; }
      footer { padding-left:18px; padding-right:18px; }
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">株式会社創正</a>
    <nav aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </header>
  <main><slot /></main>
  <footer>© Sowsei Inc.</footer>
</body>
</html>
