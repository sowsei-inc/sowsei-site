---
const { title = 'Sowsei Inc.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#191919;background:#fffdf8}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(980px,calc(100% - 48px));margin:auto}header{padding:30px 0 18px;display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #c9c5bb}.brand{font-size:1.35rem;font-weight:700;text-decoration:none}nav{display:flex;gap:22px;font: .7rem Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase}nav a{text-decoration:none}.hero{padding:13vh 0 10vh}.eyebrow,.section-label{font: .68rem Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.hero h1{font-size:clamp(2.8rem,6.5vw,5.7rem);font-weight:400;line-height:1.02;letter-spacing:-.045em;margin:22px 0 28px;max-width:850px}.hero p{font-size:1.05rem;line-height:1.85;max-width:620px}.works{border-top:1px solid #222}.work{display:grid;grid-template-columns:140px 1fr auto;gap:24px;padding:28px 0;border-bottom:1px solid #c9c5bb;align-items:baseline}.work .state{font:.68rem Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase}.work strong{font-size:1.55rem;font-weight:400}.work small{font:.78rem Arial,sans-serif;color:#777}.after{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:72px 0 13vh}.after p{margin:12px 0 0;line-height:1.8;max-width:420px}footer{border-top:1px solid #222;padding:22px 0 38px;font:.68rem Arial,sans-serif}@media(max-width:700px){header,main,footer{width:calc(100% - 30px)}header{padding:22px 0 16px}.hero{padding:10vh 0 8vh}.hero h1{font-size:3rem}.work{grid-template-columns:88px 1fr}.work small{grid-column:2}.after{grid-template-columns:1fr;gap:42px;padding:56px 0 10vh}}
</style></head><body><header><a class="brand" href={base+'/'}>Sowsei Inc.</a><nav><a href={base+'/products/'}>Works</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>株式会社創正 — Kanagawa, Japan</footer></body></html>