---
const { title = 'SOWSEI WORKS' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title>
<style is:global>
:root{font-family:"Courier New","Hiragino Kaku Gothic ProN",monospace;color:#e9e9e4;background:#151716}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}header,main{width:min(1200px,calc(100% - 40px));margin:auto}header{height:68px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #444843}.brand{font-weight:700}nav{display:flex;gap:22px;font-size:.72rem;color:#b7b9b3}.bench{padding:9vh 0 6vh}.bench h1{font-size:clamp(2.5rem,6vw,5.6rem);line-height:1;letter-spacing:-.055em;margin:0 0 26px}.bench p{color:#b7b9b3;max-width:680px;line-height:1.7}.label{font-size:.68rem;color:#8e918a;margin-bottom:16px}.board{border-top:1px solid #444843}.job{display:grid;grid-template-columns:110px 1fr 120px;gap:20px;padding:24px 0;border-bottom:1px solid #444843;align-items:center}.job .id,.job .state{font-size:.7rem;color:#9fa29b}.job strong{font-size:1.25rem}.state{text-align:right}.active{color:#dfe6a1!important}.labnote{margin:70px 0 12vh;padding:24px;border:1px solid #444843;display:grid;grid-template-columns:150px 1fr;gap:24px}.labnote p{margin:0;color:#b7b9b3;line-height:1.7}footer{border-top:1px solid #444843;padding:24px max(20px,calc((100vw - 1200px)/2));font-size:.68rem;color:#8e918a}@media(max-width:700px){header,main{width:calc(100% - 28px)}header{height:60px}nav{gap:13px}.bench{padding:9vh 0 5vh}.bench h1{font-size:3rem}.job{grid-template-columns:58px 1fr}.state{grid-column:2;text-align:left}.labnote{grid-template-columns:1fr}}
</style></head><body><header><a class="brand" href={base+'/'}>SOWSEI / WORKS</a><nav><a href={base+'/products/'}>OUTPUT</a><a href={base+'/about/'}>SHOP</a><a href={base+'/contact/'}>CONTACT</a></nav></header><main><slot/></main><footer>SOWSEI INC. / KANAGAWA / JAPAN</footer></body></html>