---
const { title = '株式会社創正' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title>
<style is:global>
:root{font-family:Georgia,"Yu Mincho",serif;color:#171717;background:#f7f4ec}*{box-sizing:border-box}body{margin:0}a{color:inherit}header,main,footer{width:min(1080px,calc(100% - 48px));margin:auto}header{height:66px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #bdb8ad;position:relative;z-index:2}.brand{font-size:1rem;font-weight:700;text-decoration:none}nav{display:flex;gap:20px;font:.64rem Arial,sans-serif}nav a{text-decoration:none}footer{border-top:1px solid #222;padding:15px 0 22px;font:.61rem Arial,sans-serif;color:#555}.hero{display:grid;grid-template-columns:.78fr 1.22fr;min-height:390px;border-bottom:1px solid #222}.hero-copy{padding:54px 28px 34px 0;display:flex;flex-direction:column;justify-content:space-between}.hero-copy p{font-size:.9rem;line-height:1.75;max-width:330px;margin:0}.hero-copy small{font:.6rem Arial,sans-serif;color:#777}.hero-art{position:relative;overflow:hidden;background:#111;min-height:390px}.hero-art:before{content:"";position:absolute;inset:-12%;background:repeating-linear-gradient(118deg,transparent 0 42px,#ffffff12 43px 44px),radial-gradient(circle at 68% 35%,#f5f0df 0 3%,transparent 3.2%),radial-gradient(circle at 38% 68%,#d7d0be 0 5%,transparent 5.2%);transform:rotate(-4deg)}.hero-art:after{content:"SOUSEI";position:absolute;right:-12px;bottom:-22px;font:700 clamp(4.8rem,12vw,9rem) Arial,sans-serif;letter-spacing:-.08em;color:#ffffff0d}.works{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid #222}.work{min-height:280px;padding:26px;position:relative;overflow:hidden;text-decoration:none}.work:first-child{border-right:1px solid #222;background:#e7e1d4}.work .label,.page-label{font:.59rem Arial,sans-serif;color:#666;letter-spacing:.04em}.work h2{font-size:1.25rem;font-weight:400;margin:9px 0 5px}.work p{font-size:.75rem;line-height:1.55;max-width:290px;margin:0;color:#555}.work .arrow{position:absolute;right:24px;bottom:20px;font:.65rem Arial,sans-serif}.iro-art{position:absolute;right:-20px;bottom:-45px;width:48%;height:220px;border:1px solid #777;border-radius:28px 28px 0 0;background:#f9f7f1;transform:rotate(7deg);box-shadow:-16px 12px 35px #00000012}.iro-art:before{content:"";position:absolute;top:32px;left:18px;right:18px;height:1px;background:#bbb;box-shadow:0 40px #bbb,0 80px #bbb}.line-art{position:absolute;left:26px;right:26px;bottom:42px;height:88px}.line-art svg{width:100%;height:100%;overflow:visible}.line-art path{fill:none;stroke:#222;stroke-width:1.2}.line-art circle{fill:#f7f4ec;stroke:#222;stroke-width:1.2}.line-art .solid{fill:#222}.about-band{display:grid;grid-template-columns:1fr 1fr;gap:30px;padding:24px 0 28px}.about-band p{font-size:.78rem;line-height:1.65;margin:0;max-width:500px}.links{display:flex;justify-content:flex-end;align-items:flex-end;gap:20px;font-size:.72rem}.links a{text-underline-offset:4px}.page-head{display:grid;grid-template-columns:130px 1fr;padding:38px 0 28px;border-bottom:1px solid #222}.page-head h1{font-size:1.45rem;font-weight:400;margin:0 0 8px}.page-head p,.detail p{font-size:.8rem;line-height:1.7;max-width:620px;margin:0}.visual-panel{min-height:260px;margin:22px 0;background:#171717;position:relative;overflow:hidden}.visual-panel:before{content:"";position:absolute;inset:-20%;background:repeating-linear-gradient(120deg,transparent 0 50px,#ffffff13 51px 52px)}.detail{padding:22px 0;border-bottom:1px solid #bbb}.detail h2{font:.62rem Arial,sans-serif;color:#666;font-weight:400;margin:0 0 9px}.detail h2:not(:first-child){margin-top:24px}.big-line{height:210px;margin:20px 0;border-top:1px solid #222;border-bottom:1px solid #222;display:flex;align-items:center}.big-line svg{width:100%;height:130px}.big-line path{fill:none;stroke:#222;stroke-width:1.2}.big-line circle{fill:#f7f4ec;stroke:#222;stroke-width:1.2}.big-line .solid{fill:#222}.page-list{border-bottom:1px solid #222}.page-row{display:grid;grid-template-columns:100px 1fr auto;gap:18px;padding:18px 0;border-bottom:1px solid #bbb;text-decoration:none}.page-row:last-child{border:0}.page-row span,.page-row b{font:.6rem Arial,sans-serif;color:#666;font-weight:400}.page-row strong{font-size:1rem;font-weight:400}.page-row p{font-size:.72rem;color:#555;margin:5px 0 0}
@media(max-width:700px){header,main,footer{width:calc(100% - 28px)}header{height:54px}.brand{font-size:.92rem}nav{gap:13px;font-size:.58rem}.hero{grid-template-columns:1fr;min-height:0}.hero-copy{padding:22px 0 17px;min-height:132px}.hero-copy p{font-size:.78rem;line-height:1.65;max-width:300px}.hero-art{min-height:190px}.works{grid-template-columns:1fr}.work{min-height:205px;padding:17px 14px}.work:first-child{border-right:0;border-bottom:1px solid #222}.work h2{font-size:1rem;margin:6px 0 4px}.work p{font-size:.68rem}.iro-art{height:150px;width:43%;right:-8px;bottom:-42px;border-radius:20px 20px 0 0}.line-art{left:14px;right:14px;bottom:28px;height:62px}.about-band{grid-template-columns:1fr;padding:16px 0 20px;gap:12px}.about-band p{font-size:.71rem}.links{justify-content:flex-start;font-size:.68rem}.page-head{grid-template-columns:1fr;padding:20px 0 16px;gap:7px}.page-head h1{font-size:1.05rem}.page-head p,.detail p{font-size:.73rem}.visual-panel{min-height:180px;margin:14px 0}.big-line{height:145px;margin:14px 0}.big-line svg{height:90px}.page-row{grid-template-columns:55px 1fr auto;gap:9px;padding:13px 0}.page-row strong{font-size:.9rem}.page-row p{font-size:.66rem}}
</style></head><body><header><a class="brand" href={base+'/'}>株式会社創正</a><nav><a href={base+'/products/'}>Products</a><a href={base+'/sousei-line/'}>Sousei-line</a><a href={base+'/about/'}>Company</a><a href={base+'/contact/'}>Contact</a></nav></header><main><slot/></main><footer>Sowsei Inc. — Kanagawa, Japan</footer></body></html>