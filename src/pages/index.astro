---
import '../styles/global.css';

const products = [
  { name: 'Iro', desc: 'ことばで選んで、ちょうどいい色へ。', kind: 'yellow', href: 'https://iro.sowsei.jp/' },
  { name: 'Sousei-line', desc: 'ソフトウェアの製造・検品工程', kind: 'blue', href: 'https://github.com/sowsei-inc/sousei-line' },
];

const serviceDomain = import.meta.env.MICROCMS_SERVICE_DOMAIN;
const apiKey = import.meta.env.MICROCMS_API_KEY;

let heroTitle = 'つくる。なおす。考える。';
let heroDescription = '株式会社創正は、対象に合わせてものを作り、考え、仕事をしています。';

if (serviceDomain && apiKey) {
  const response = await fetch(`https://${serviceDomain}.microcms.io/api/v1/site`, {
    headers: { 'X-MICROCMS-API-KEY': apiKey },
  });

  if (!response.ok) {
    throw new Error(`microCMS request failed: ${response.status} ${response.statusText}`);
  }

  const site = await response.json();
  heroTitle = site.heroTitle ?? heroTitle;
  heroDescription = site.heroDescription ?? heroDescription;
}
---
<!doctype html>
<html lang="ja">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1.0" /><meta name="theme-color" content="#ff5a36" /><title>株式会社創正</title></head>
<body>
<header><a href="#top">株式会社創正</a><nav><a href="#products">事業・製品</a><a href="#about">会社</a><a href="#contact">連絡</a></nav></header>
<main id="top">
<section class="hero"><div><small>株式会社創正</small><h1>{heroTitle}</h1><p>{heroDescription}</p></div><aside><strong>創正</strong><span>2026</span></aside></section>
<section class="products" id="products"><div class="section-head"><small>事業・製品</small><h2>いま、やっていること。</h2></div><div class="product-list">{products.map((p) => <a class={`product ${p.kind}`} href={p.href}><strong>{p.name}</strong><span>{p.desc}</span><b>→</b></a>)}</div></section>
<section class="about" id="about"><small>会社について</small><h2>株式会社創正</h2><p>代表取締役　山下 正人<br/>所在地　神奈川県秦野市</p></section>
<section class="contact" id="contact"><small>お問い合わせ</small><h2>仕事や製品について、<br/>ご連絡ください。</h2><a href="mailto:info@sowsei.jp">info@sowsei.jp →</a></section>
</main><footer><b>株式会社創正</b><span>© 2026</span></footer>
</body></html>
